# Puerto donde levanta la API
PORT=4000

# Conexion a MongoDB
MONGO_URL=mongodb://127.0.0.1:27017/
MONGO_DB=institucion_educativa

# JWT
JWT_SECRET=cambiar_por_un_secreto_largo
JWT_ISSUER=institucion-educativa
JWT_EXPIRES_IN=8h

# Nivel de log de winston (error, warn, info, verbose, debug)
LOG_LEVEL=info
